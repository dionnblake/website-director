      "required": false,
      "status": "NOT_REQUIRED",
      "business_reason": "Account identity and sign-in only when user stories require it.",
      "data_classes": ["identity", "credentials"],
      "security_risk": "HIGH",
      "external_provider": null,
      "owner": "application",
      "dependencies": ["API", "DATABASE"],
      "verification_required": true,
      "exception": {"applied": false, "reason": null}
    },
    {
      "module_id": "AUTHORIZATION",
      "required": false,
      "status": "NOT_REQUIRED",
      "business_reason": "Server-side roles and object access only when protected behavior requires it.",
