{
  "$schema": "../schemas/inspiration-source-registry.schema.json",
  "registry_version": "1.0.0",
  "status": "REFERENCE_ONLY",
  "owner_selection_contract": {
    "required_input_fields": [
      "SOURCE",
      "REFERENCE_URL",
      "REFERENCE_TYPE",
      "ELEMENT_OR_SECTION",
      "WHAT_I_LIKE",
      "WHAT_I_DO_NOT_WANT",
      "WHY_IS_THIS_RELEVANT"
    ],
    "required_interpretation_fields": [
      "OWNER_SELECTED_REFERENCE",
      "SOURCE",
      "URL",
      "ASSIGNED_DIMENSION",
      "PATTERN_TO_LEARN",
      "OWNER_REQUESTED_ELEMENT",
      "WHY_IS_THIS_RELEVANT",
      "WHAT_NOT_TO_COPY",
      "REFERENCE_GRADE",
      "LICENSE_STATUS",
      "IMPLEMENTATION_RISK",
      "ACCESSIBILITY_RISK",
      "PRODUCTION_PLAUSIBILITY",
      "REFERENCE_ONLY_STATUS"
    ],
    "default_reference_status": "REFERENCE_ONLY",
    "reuse_policy": [
      "VERIFY_LICENSE",
      "RECORD_PROVENANCE",
      "ADAPT_TO_PROJECT_STACK",
      "ADAPT_TO_DESIGN_SYSTEM",
      "OWNER_AUTHORIZATION_BEFORE_SOURCE_REUSE"
    ]
  },
  "sources": [
    {
      "source_id": "21ST_DEV",
      "url": "https://21st.dev/",
      "role": "COMPONENT_PATTERN_LIBRARY",
      "reference_only_default": true,
      "allowed_patterns": [
        "heroes",
        "backgrounds",
        "navigation",
        "ctas",
        "forms",
        "galleries",
        "scroll_patterns",
        "shaders",
        "text_effects",
        "micro_interactions",
        "section_composition"
      ],
      "source_reuse_requires": [
        "VERIFY_LICENSE",
        "RECORD_PROVENANCE",
        "ADAPT_TO_PROJECT_STACK",
        "ADAPT_TO_DESIGN_SYSTEM"
      ],
      "notes": "A component's source framework is not an instruction to force that framework on the project. Extract the mechanic when another stack is selected."
    },
    {
      "source_id": "GODLY",
      "url": "https://godly.design/",
      "role": "CURATED_SITE_AND_SECTION_DISCOVERY",
      "reference_only_default": true,
