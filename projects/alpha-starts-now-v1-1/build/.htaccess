# Alpha Starts Now (V1.1) — Hostinger Apache / LiteSpeed Configuration

RewriteEngine On

# 1. Map /api/subscribe to /api/subscribe.php internally
RewriteRule ^api/subscribe/?$ api/subscribe.php [L,QSA]

# 2. Block direct web access to sensitive or configuration files
<FilesMatch "^(asn-secrets|.*\.env|.*\.example\.php|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. UTF-8 Encoding
AddDefaultCharset UTF-8
